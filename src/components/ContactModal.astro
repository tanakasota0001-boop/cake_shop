---
import { siteConfig } from '../data/siteConfig';
const { store } = siteConfig;
const { contact: contactText } = siteConfig.content;
---

<div
  id="contact-modal"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  style="display: none;"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="contact-modal-backdrop"
    class="fixed inset-0 bg-noir-950/85 backdrop-blur-sm transition-opacity"
    onclick="closeContactModal()"
  ></div>

  <!-- Screen Fixed Close Button -->
  <button
    type="button"
    onclick="closeContactModal()"
    class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50 flex items-center gap-2 px-4 py-2 bg-cream-50/95 hover:bg-noir-900 hover:text-cream-50 text-stone-900 text-xs font-sans tracking-widest uppercase rounded-full shadow-2xl transition-all duration-200 border border-stone-300 group"
    aria-label="閉じる"
  >
    <svg class="w-4 h-4 group-hover:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    <span class="font-medium">閉じる</span>
  </button>

  <!-- Modal Container -->
  <div class="min-h-full flex items-center justify-center p-4 sm:p-6 text-center">
    <div
      id="contact-modal-card"
      class="relative bg-cream-50 max-w-xl w-full text-left rounded-sm shadow-2xl border border-stone-300 p-6 sm:p-8 my-8 z-10"
      onclick="event.stopPropagation()"
    >
      <!-- Modal Header -->
      <div class="text-center space-y-2 mb-6">
        <span class="text-[10px] font-sans tracking-mega-wide uppercase text-gold-600 block">{contactText.badge}</span>
        <h3 class="text-2xl sm:text-3xl font-serif-title tracking-wider uppercase text-noir-900 font-light">{contactText.titleEn}</h3>
        <div class="w-10 h-[1px] bg-gold-400 mx-auto"></div>
        <p class="text-xs text-stone-600 font-serif-jp">
          {contactText.subtitleJa} — {contactText.desc}
        </p>
      </div>

      <!-- Phone Notice -->
      <div class="mb-6 p-4 bg-cream-200 border border-stone-300/80 rounded-sm text-center">
        <p class="text-xs text-stone-600 font-serif-jp mb-1">{contactText.phoneNoticeTitle}</p>
        <a href={`tel:${store.tel.replace(/-/g, '')}`} class="text-lg font-sans font-bold text-noir-900 hover:text-gold-600 transition-colors inline-flex items-center gap-2">
          <svg class="w-4 h-4 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {store.tel}
        </a>
        <p class="text-[10px] text-stone-500 mt-0.5">受付時間：{store.businessHours}（{store.holidays}定休）</p>
      </div>

      <!-- Contact Form -->
      <form id="contact-form" class="space-y-4 text-xs font-serif-jp" onsubmit="handleContactSubmit(event)">
        <div>
          <label for="contact-purpose" class="block font-medium text-stone-800 mb-1">{contactText.form.purposeLabel} <span class="text-berry-700">*</span></label>
          <select
            id="contact-purpose"
            required
            class="w-full px-3 py-2.5 bg-white border border-stone-300 rounded-sm focus:outline-none focus:border-gold-500 text-stone-900"
          >
            <option value="">{contactText.form.purposePlaceholder}</option>
            {contactText.purposes.map((purpose: string) => (
              <option value={purpose}>{purpose}</option>
            ))}
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block font-medium text-stone-800 mb-1">{contactText.form.nameLabel} <span class="text-berry-700">*</span></label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder={contactText.form.namePlaceholder}
              class="w-full px-3 py-2.5 bg-white border border-stone-300 rounded-sm focus:outline-none focus:border-gold-500 text-stone-900"
            />
          </div>
          <div>
            <label for="contact-phone" class="block font-medium text-stone-800 mb-1">{contactText.form.phoneLabel} <span class="text-berry-700">*</span></label>
            <input
              type="tel"
              id="contact-phone"
              required
              placeholder={contactText.form.phonePlaceholder}
              class="w-full px-3 py-2.5 bg-white border border-stone-300 rounded-sm focus:outline-none focus:border-gold-500 text-stone-900"
            />
          </div>
        </div>

        <div>
          <label for="contact-email" class="block font-medium text-stone-800 mb-1">{contactText.form.emailLabel} <span class="text-berry-700">*</span></label>
          <input
            type="email"
            id="contact-email"
            required
            placeholder={contactText.form.emailPlaceholder}
            class="w-full px-3 py-2.5 bg-white border border-stone-300 rounded-sm focus:outline-none focus:border-gold-500 text-stone-900"
          />
        </div>

        <div>
          <label for="contact-message" class="block font-medium text-stone-800 mb-1">{contactText.form.messageLabel} <span class="text-berry-700">*</span></label>
          <textarea
            id="contact-message"
            rows="5"
            required
            placeholder={contactText.form.messagePlaceholder}
            class="w-full px-3 py-2.5 bg-white border border-stone-300 rounded-sm focus:outline-none focus:border-gold-500 text-stone-900"
          ></textarea>
        </div>

        <div class="pt-4 space-y-2">
          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-3 bg-noir-900 text-cream-50 text-xs font-sans tracking-widest uppercase hover:bg-gold-600 transition-colors font-medium text-center flex items-center justify-center gap-2 rounded-sm shadow-sm"
          >
            <span>{contactText.form.submitBtnText}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
          <button
            type="button"
            onclick="closeContactModal()"
            class="w-full py-2.5 bg-transparent border border-stone-300 text-stone-600 hover:text-stone-900 hover:border-stone-500 text-xs font-sans tracking-widest uppercase transition-colors rounded-sm text-center"
          >
            {contactText.form.cancelBtnText}
          </button>
        </div>
      </form>

      <!-- Success Message Box -->
      <div id="contact-success-msg" class="hidden text-center py-10 space-y-4">
        <div class="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h4 class="text-xl font-serif-jp text-stone-900 font-medium">{contactText.success.title}</h4>
        <p class="text-xs text-stone-600 font-serif-jp max-w-sm mx-auto leading-relaxed">
          {contactText.success.message}
        </p>
        <button
          type="button"
          onclick="closeContactModal()"
          class="mt-4 px-6 py-2.5 bg-noir-900 text-cream-50 text-xs font-sans tracking-widest uppercase rounded-sm hover:bg-gold-600 transition-colors"
        >
          {contactText.success.closeBtnText}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const contactModal = document.getElementById('contact-modal');
  const contactForm = document.getElementById('contact-form');
  const contactSuccess = document.getElementById('contact-success-msg');
  const contactPurposeSelect = document.getElementById('contact-purpose');

  window.openContactModal = function(defaultPurpose) {
    if (!contactModal) return;
    if (contactForm) contactForm.style.display = 'block';
    if (contactSuccess) contactSuccess.classList.add('hidden');
    if (contactPurposeSelect && defaultPurpose) {
      contactPurposeSelect.value = defaultPurpose;
    }
    contactModal.classList.remove('hidden');
    contactModal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  };

  window.closeContactModal = function() {
    if (!contactModal) return;
    contactModal.classList.add('hidden');
    contactModal.style.display = 'none';
    document.body.style.overflow = '';
  };

  window.handleContactSubmit = function(e) {
    e.preventDefault();
    if (contactForm) contactForm.style.display = 'none';
    if (contactSuccess) contactSuccess.classList.remove('hidden');
    if (contactForm) contactForm.reset();
  };
</script>
