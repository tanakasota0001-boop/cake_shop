---
import { siteConfig } from '../data/siteConfig';
const { specialite: specConfig } = siteConfig.images;
const { specialite: specText } = siteConfig.content;
---

<section id="specialty" class="relative bg-[#faf7f2] text-stone-900 border-t border-stone-200/80 overflow-hidden">
  <style>
    /* Sticky behavior for the content side on desktop */
    @media screen and (min-width: 1024px) {
      .yc-content-wrapper {
        position: sticky;
        top: 5rem;
        height: calc(100vh - 5rem);
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    /* Images gallery grid styling matching Yann Couvreur */
    .yc-images-gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 10px 0;
    }

    @media screen and (min-width: 640px) {
      .yc-images-gallery {
        gap: 12px;
        padding: 12px 0;
      }
    }

    /* Base 4:5 aspect ratio for gallery cards */
    .yc-gallery-item {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: #ede7de;
    }

    /* 3rd and 6th items span 2 columns with 3:2 panoramic aspect ratio */
    .yc-gallery-item:nth-child(3),
    .yc-gallery-item:nth-child(6) {
      grid-column: span 2;
      aspect-ratio: 3 / 2 !important;
    }

    .yc-gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .yc-gallery-item:hover img {
      transform: scale(1.05);
    }

    /* Elegant gradient caption at bottom */
    .yc-gallery-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 2.5rem 1.25rem 1rem;
      background: linear-gradient(to top, rgba(15, 12, 10, 0.78) 0%, rgba(15, 12, 10, 0.35) 60%, transparent 100%);
      color: #faf7f2;
      text-align: center;
      transition: all 0.3s ease;
    }
  </style>

  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-10 scroll-fade-in">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      
      <!-- Left Content (Sticky on Desktop) -->
      <div class="lg:col-span-5 yc-content-wrapper py-12 sm:py-16 lg:py-0">
        <div class="w-full max-w-lg mx-auto text-center space-y-6 lg:space-y-8 px-2">
          
          <!-- Subheading / Badge -->
          <div>
            <span class="inline-block px-3.5 py-1 text-[11px] font-sans tracking-mega-wide uppercase text-gold-700 bg-gold-500/10 border border-gold-500/20 rounded-full mb-3">
              Découvrez ・ {specText.badge}
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-serif-jp text-stone-900 font-light leading-snug sm:leading-tight tracking-wide whitespace-pre-line">
              {specText.heading}
            </h2>
            <div class="w-10 h-[1px] bg-gold-400 mx-auto mt-4"></div>
          </div>

          <!-- Description Text -->
          <p class="text-stone-600 font-serif-jp text-xs sm:text-sm leading-relaxed tracking-wider">
            {specText.desc}
          </p>

          <!-- Occasions Tags -->
          <div class="flex flex-wrap justify-center gap-2 pt-1 pb-2">
            <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-cream-200/80 text-stone-700 rounded-sm"># 誕生日</span>
            <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-cream-200/80 text-stone-700 rounded-sm"># クリスマス</span>
            <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-cream-200/80 text-stone-700 rounded-sm"># アニバーサリー</span>
            <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-cream-200/80 text-stone-700 rounded-sm"># ウェディング</span>
          </div>

          <!-- Buttons Group (Yann Couvreur Style) -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <button
              type="button"
              onclick="openContactModal('ホールケーキ・オーダーメイドのご予約・ご相談')"
              class="w-full sm:w-auto px-7 py-3.5 bg-noir-900 text-cream-50 text-xs font-sans tracking-widest uppercase hover:bg-gold-600 transition-colors font-medium rounded-sm shadow-sm"
            >
              {specText.catalogBtn}
            </button>
            <a
              href="#collection"
              class="w-full sm:w-auto px-6 py-3.5 text-xs font-sans tracking-widest uppercase text-stone-700 hover:text-stone-950 border border-stone-300 hover:border-stone-800 transition-all rounded-sm text-center"
            >
              {specText.menuLink}
            </a>
          </div>

          <p class="text-[11px] text-stone-400 font-serif-jp pt-2">
            ※ ご注文・ご相談は受取日の3日〜1週間前まで承っております。
          </p>

        </div>
      </div>

      <!-- Right Gallery (Scrollable 2-column Grid with Panoramic Accents) -->
      <div class="lg:col-span-7 py-8 sm:py-12 lg:py-16">
        <div class="yc-images-gallery">
          {specConfig.items.map((item) => (
            <div class="yc-gallery-item group cursor-pointer" onclick="openContactModal('ホールケーキ・オーダーメイドのご予約・ご相談')">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover"
              />
              <div class="yc-gallery-caption">
                <p class="text-xs sm:text-sm font-sans tracking-mega-wide uppercase font-medium drop-shadow-sm">
                  {item.title}
                </p>
                <p class="text-[10px] sm:text-[11px] font-serif-jp text-cream-200/90 tracking-widest mt-0.5 opacity-90">
                  {item.subTitle}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
