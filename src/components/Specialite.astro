---
import { siteConfig } from '../data/siteConfig';
const { specialite: specConfig } = siteConfig.images;
const { specialite: specText } = siteConfig.content;
---

<section id="specialty" class="py-24 sm:py-32 bg-cream-50 text-noir-900 border-t border-stone-200/60 relative">
  <style>
    /* Sticky behavior for the content side on desktop */
    @media screen and (min-width: 1024px) {
      .yc-content-wrapper {
        position: sticky;
        top: 6rem;
        align-self: flex-start;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 8rem);
      }
    }

    /* Images gallery grid styling */
    .yc-images-gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    @media screen and (min-width: 640px) {
      .yc-images-gallery {
        gap: 16px;
      }
    }

    /* Base 4:5 aspect ratio for gallery cards */
    .yc-gallery-item {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: #ede7de;
      border-radius: 2px;
    }

    /* 3rd and 6th items span 2 columns with 3:2 panoramic aspect ratio */
    .yc-gallery-item:nth-child(3),
    .yc-gallery-item:nth-child(6) {
      grid-column: span 2;
      aspect-ratio: 3 / 2 !important;
    }

    .yc-gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .yc-gallery-item:hover img {
      transform: scale(1.05);
    }

    /* Elegant gradient caption at bottom */
    .yc-gallery-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 2.5rem 1.25rem 1.25rem;
      background: linear-gradient(to top, rgba(15, 12, 10, 0.82) 0%, rgba(15, 12, 10, 0.35) 60%, transparent 100%);
      color: #faf7f2;
      text-align: center;
      transition: all 0.3s ease;
      pointer-events: none;
    }
  </style>

  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      
      <!-- Left Content (Sticky on Desktop) -->
      <div class="lg:col-span-5 yc-content-wrapper py-12 sm:py-16 lg:py-0">
        <div class="w-full max-w-lg mx-auto text-center space-y-6 lg:space-y-8 px-2 scroll-fade-in">
          
          <!-- Heading -->
          <div>
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-serif-jp text-stone-900 font-light leading-snug sm:leading-tight tracking-wide whitespace-pre-line">
              {specText.heading}
            </h2>
            <div class="w-10 h-[1px] bg-gold-400 mx-auto mt-4"></div>
          </div>

          <!-- Description Text -->
          <p class="text-stone-600 font-serif-jp text-xs sm:text-sm leading-relaxed tracking-wider">
            {specText.desc}
          </p>

          <!-- Occasions Tags -->
          {specText.tags && (
            <div class="flex flex-wrap justify-center gap-2 pt-1 pb-2">
              {specText.tags.map((tag: string) => (
                <span class="text-[11px] font-sans tracking-wider px-3 py-1 bg-cream-200/80 text-stone-700 rounded-sm border border-stone-300/40">{tag}</span>
              ))}
            </div>
          )}

          <!-- Reservation Button -->
          <div class="pt-2">
            <button
              type="button"
              onclick="openContactModal('ホールケーキ・オーダーメイドのご予約・ご相談')"
              class="w-full sm:w-auto px-8 py-3.5 bg-noir-900 text-cream-50 text-xs font-sans tracking-widest uppercase hover:bg-gold-600 transition-colors font-medium rounded-sm shadow-sm inline-flex items-center justify-center gap-2 group"
            >
              <span>{specText.catalogBtn}</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Gallery (Scrollable 2-column Grid with Panoramic Accents) -->
      <div class="lg:col-span-7 py-8 sm:py-12 lg:py-16">
        <div class="yc-images-gallery">
          {specConfig.items.map((item) => (
            <div class="yc-gallery-item group cursor-pointer shadow-sm" onclick="openContactModal('ホールケーキ・オーダーメイドのご予約・ご相談')">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover"
              />
              <!-- Subtle Monochrome Hover Overlay matching ProductSection & Instagram -->
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white shadow-lg transform translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
                  <span class="text-xs font-serif-jp tracking-wider text-white/95 font-medium">{specText.hoverBadge}</span>
                  <svg class="w-3.5 h-3.5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </div>
              </div>
              <div class="yc-gallery-caption z-20">
                <p class="text-xs sm:text-sm font-sans tracking-mega-wide uppercase font-medium drop-shadow-sm">
                  {item.title}
                </p>
                <p class="text-[10px] sm:text-[11px] font-serif-jp text-cream-200/90 tracking-widest mt-0.5 opacity-90">
                  {item.subTitle}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
