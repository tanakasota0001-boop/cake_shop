---
import { products, categories } from '../data/products';
import { siteConfig } from '../data/siteConfig';
const { menu } = siteConfig.content;
---

<section id="collection" class="py-24 sm:py-32 bg-cream-50 text-noir-900 relative">
  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-10 scroll-fade-in">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16 sm:mb-20">
      <span class="text-xs font-sans tracking-mega-wide uppercase text-gold-600 block">{menu.badge}</span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-ultra-wide font-light uppercase">
        {menu.titleEn}
      </h2>
      <div class="w-12 h-[1px] bg-gold-400 mx-auto"></div>
      <p class="font-serif-jp text-sm sm:text-base text-stone-600 tracking-widest pt-2">
        {menu.subtitleJa}
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 mb-16" id="category-filter-tabs">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`cat-tab px-6 py-2.5 text-xs font-sans tracking-widest uppercase transition-all duration-300 border ${
            idx === 0
              ? 'bg-noir-900 text-cream-50 border-noir-900 shadow-sm'
              : 'bg-transparent text-stone-600 border-stone-300 hover:border-stone-800'
          }`}
          data-category={cat.id}
        >
          <span class="font-medium">{cat.label}</span>
          <span class="text-[10px] opacity-70 ml-1">({cat.subLabel})</span>
        </button>
      ))}
    </div>

    <!-- Products Grid (Image-centric, 2 cols on mobile, 4 cols on large screens) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-3 sm:gap-x-4 lg:gap-x-5 gap-y-6 sm:gap-y-10 lg:gap-y-12" id="products-grid">
      {products.map(product => (
        <div
          class="product-item group cursor-pointer flex flex-col"
          data-category={product.category}
          data-product-id={product.id}
          onclick={`openProductModal('${product.id}')`}
        >
          <!-- Portrait Image Thumbnail -->
          <div class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] overflow-hidden bg-stone-100 mb-2.5 sm:mb-3.5">
            <img
              src={product.image}
              alt={product.name}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
            />
            <!-- Subtle Hover Indicator -->
            <div class="absolute inset-0 bg-noir-950/25 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="px-3 py-1 sm:px-4 sm:py-1.5 bg-cream-50/90 text-noir-900 text-[10px] sm:text-[11px] font-sans tracking-widest uppercase font-medium backdrop-blur-sm shadow-sm">
                View Detail
              </span>
            </div>
          </div>

          <!-- Minimalist Info Below Image (Name & Price Only, Compact & Refined) -->
          <div class="flex justify-between items-baseline gap-2 sm:gap-3 pt-1">
            <h3 class="min-w-0 flex-1 text-xs sm:text-base font-serif-jp text-stone-900 group-hover:text-gold-600 transition-colors font-medium truncate">
              {product.name}
            </h3>
            <span class="text-xs sm:text-sm font-sans font-medium text-stone-700 tracking-wider flex-shrink-0">
              {product.price}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Product Detail Modal -->
<div
  id="product-modal"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  style="display: none;"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="product-modal-backdrop"
    class="fixed inset-0 bg-noir-950/85 backdrop-blur-sm transition-opacity"
    onclick="closeProductModal()"
  ></div>

  <!-- Screen Fixed Close Button -->
  <button
    type="button"
    onclick="closeProductModal()"
    class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50 flex items-center gap-2 px-4 py-2 bg-cream-50/95 hover:bg-noir-900 hover:text-cream-50 text-stone-900 text-xs font-sans tracking-widest uppercase rounded-full shadow-2xl transition-all duration-200 border border-stone-300 group"
    aria-label="閉じる"
  >
    <svg class="w-4 h-4 group-hover:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    <span class="font-medium">閉じる</span>
  </button>

  <!-- Modal Container -->
  <div class="min-h-full flex items-center justify-center p-4 sm:p-6 text-center">
    <div
      id="product-modal-card"
      class="relative bg-cream-100 max-w-3xl w-full text-left rounded-sm shadow-2xl border border-stone-300 overflow-hidden flex flex-col md:flex-row my-8 z-10"
      onclick="event.stopPropagation()"
    >
      <!-- Modal Image -->
      <div class="md:w-1/2 aspect-square md:aspect-auto relative bg-stone-200">
        <img
          id="modal-image"
          src=""
          alt=""
          class="w-full h-full object-cover min-h-[300px]"
        />
      </div>

      <!-- Modal Info -->
      <div class="p-6 sm:p-8 md:w-1/2 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div>
            <span id="modal-category" class="text-[11px] font-sans tracking-ultra-wide uppercase text-gold-600 block mb-1"></span>
            <h3 id="modal-title" class="text-2xl font-serif-jp text-noir-900 font-medium leading-snug"></h3>
          </div>

          <div class="text-lg font-sans font-medium text-stone-900 border-b border-stone-200 pb-3">
            <span id="modal-price"></span>
            <span class="text-xs text-stone-400 font-normal ml-1">（税込）</span>
          </div>

          <div>
            <p id="modal-desc" class="text-stone-700 font-serif-jp text-xs sm:text-sm leading-relaxed"></p>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-200">
          <button
            type="button"
            onclick="closeProductModal()"
            class="w-full py-2.5 bg-noir-900 text-cream-50 hover:bg-stone-800 text-xs font-sans tracking-widest uppercase transition-colors rounded-sm text-center"
          >
            閉じる
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ products }}>
  window.__PRODUCTS_DATA__ = products;
</script>

<script is:inline>
  // Category filtering
  const tabs = document.querySelectorAll('.cat-tab');
  const items = document.querySelectorAll('.product-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-noir-900', 'text-cream-50', 'border-noir-900', 'shadow-sm');
        t.classList.add('bg-transparent', 'text-stone-600', 'border-stone-300');
      });
      tab.classList.add('bg-noir-900', 'text-cream-50', 'border-noir-900', 'shadow-sm');
      tab.classList.remove('bg-transparent', 'text-stone-600', 'border-stone-300');

      const selectedCategory = tab.getAttribute('data-category');

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCat === selectedCategory) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Modal logic
  const modal = document.getElementById('product-modal');
  const modalImage = document.getElementById('modal-image');
  const modalCategory = document.getElementById('modal-category');
  const modalTitle = document.getElementById('modal-title');
  const modalPrice = document.getElementById('modal-price');
  const modalDesc = document.getElementById('modal-desc');

  window.openProductModal = function(productId) {
    const p = window.__PRODUCTS_DATA__?.find(item => item.id === productId);
    if (!p || !modal) return;

    modalImage.src = p.image;
    modalImage.alt = p.name;
    modalCategory.textContent = p.categoryLabel;
    modalTitle.textContent = p.name;
    modalPrice.textContent = p.price;
    modalDesc.textContent = p.description;

    modal.classList.remove('hidden');
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  };

  window.closeProductModal = function() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };
</script>
