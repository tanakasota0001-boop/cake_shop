---
import { siteConfig } from '../data/siteConfig';
const { about: aboutImg } = siteConfig.images;
const { about: aboutText } = siteConfig.content;
const { store } = siteConfig;
---

<section id="about" class="py-24 sm:py-32 bg-cream-200 text-noir-900 relative overflow-hidden">
  <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      <!-- Chef / Atelier Image Left -->
      <div class="lg:col-span-6 relative">
        <div class="relative overflow-hidden shadow-2xl border border-stone-300">
          <img
            src={aboutImg.image}
            alt="Pastry Chef at Kitchen"
            class="w-full h-[500px] sm:h-[620px] object-cover object-top hover:scale-102 transition-transform duration-700"
          />
        </div>
      </div>

      <!-- Message Right -->
      <div class="lg:col-span-6 space-y-8 lg:pl-4">
        <div class="space-y-3">
          <span class="text-xs font-sans tracking-mega-wide uppercase text-gold-600 block">{aboutText.badge}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif-title tracking-ultra-wide font-light uppercase text-noir-900">
            {aboutText.titleEn}
          </h2>
          <div class="w-12 h-[1px] bg-gold-400"></div>
          <p class="font-serif-jp text-sm sm:text-base text-stone-600 tracking-widest pt-1">{aboutText.subtitleJa}</p>
        </div>

        <div class="space-y-5 text-stone-700 font-serif-jp text-sm sm:text-base leading-loose tracking-wide">
          {aboutText.paragraphs.map(p => (
            <p>{p}</p>
          ))}
        </div>

        <!-- Owner Chef Signature Right Bottom -->
        <div class="pt-4 text-right">
          <p class="text-xs font-serif-jp tracking-widest text-stone-500">{aboutText.chefTitle}</p>
          <p class="text-lg sm:text-xl font-serif-jp tracking-wider text-stone-900 font-medium mt-1">
            {aboutText.chefName}
            {aboutText.chefNameEn && <span class="text-xs font-sans text-stone-400 tracking-widest uppercase ml-2">{aboutText.chefNameEn}</span>}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
