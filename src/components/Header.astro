---
import { siteConfig } from '../data/siteConfig';
const { store } = siteConfig;
---

<!-- Header Wrapper: Fixed overlay so Hero is visible behind -->
<div id="header-wrapper" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 text-cream-50 bg-transparent">
  <!-- Announcement Bar (Desktop) - Rich Warm Cream / Custard tone with higher saturation -->
  <div id="announcement-bar" class="text-xs py-2.5 px-4 border-b border-stone-300/80 hidden md:block bg-[#f3ecd8] text-stone-800 shadow-sm">
    <div class="max-w-7xl mx-auto flex justify-between items-center tracking-widest font-serif-jp text-[11px]">
      <div class="flex items-center space-x-6">
        <span class="flex items-center gap-1.5 text-stone-800 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {store.accessList[0]}
        </span>
        <span class="h-3 w-px bg-stone-400/40"></span>
        <span class="flex items-center gap-1.5 text-stone-800 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          営業時間 {store.businessHours}（{store.holidays}定休）
        </span>
      </div>
      <div class="flex items-center space-x-4">
        <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-600 text-stone-800 font-medium transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Tel. {store.tel}
        </a>
        <span class="h-3 w-px bg-stone-400/40"></span>
        <a href={store.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-stone-800 font-medium transition-colors" aria-label="Instagram">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <header id="main-header" class="w-full transition-all duration-300 border-b-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        <!-- Logo -->
        <a href="#" class="group flex flex-col items-start focus:outline-none">
          <span id="logo-title" class="font-serif-title tracking-mega-wide text-xl sm:text-2xl font-light transition-colors uppercase drop-shadow-sm">
            {store.nameEn}
          </span>
          <span id="logo-subtitle" class="text-[10px] tracking-ultra-wide transition-colors font-sans uppercase opacity-80">
            {store.subtitle}
          </span>
        </a>

        <!-- Desktop Nav -->
        <nav id="desktop-nav" class="hidden lg:flex items-center space-x-8 text-xs font-sans tracking-widest transition-colors">
          <a href="#concept" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">Concept</a>
          <a href="#specialty" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">Specialty</a>
          <a href="#collection" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">Menu</a>
          <a href="#about" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">About</a>
          <a href="#news" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">News</a>
          <a href="#store" class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">Store</a>
        </nav>

        <!-- Action Button -->
        <div class="hidden sm:flex items-center space-x-3">
          <button
            type="button"
            id="contact-btn"
            onclick="openContactModal()"
            class="relative px-5 py-2.5 text-xs tracking-widest uppercase border transition-all duration-300 font-medium group backdrop-blur-sm"
          >
            <span class="flex items-center gap-2">
              <span>お問い合わせ</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </span>
          </button>
        </div>

        <!-- Mobile Menu Button -->
        <div class="flex items-center lg:hidden">
          <button
            type="button"
            id="mobile-menu-toggle"
            class="p-2 transition-colors focus:outline-none"
            aria-label="メニューを開く"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden lg:hidden bg-noir-950/95 backdrop-blur-md border-b border-white/10 px-6 pt-4 pb-8 space-y-4 text-cream-100">
      <div class="flex flex-col space-y-4 text-sm font-sans tracking-widest border-b border-white/10 pb-6">
        <a href="#concept" class="mobile-nav-link hover:text-gold-400 py-1">CONCEPT <span class="text-xs text-stone-400 ml-2">こだわり</span></a>
        <a href="#specialty" class="mobile-nav-link hover:text-gold-400 py-1">SPECIALTY <span class="text-xs text-stone-400 ml-2">看板商品</span></a>
        <a href="#collection" class="mobile-nav-link hover:text-gold-400 py-1">MENU <span class="text-xs text-stone-400 ml-2">商品一覧</span></a>
        <a href="#about" class="mobile-nav-link hover:text-gold-400 py-1">ABOUT <span class="text-xs text-stone-400 ml-2">職人の想い</span></a>
        <a href="#news" class="mobile-nav-link hover:text-gold-400 py-1">NEWS <span class="text-xs text-stone-400 ml-2">お知らせ</span></a>
        <a href="#store" class="mobile-nav-link hover:text-gold-400 py-1">STORE <span class="text-xs text-stone-400 ml-2">店舗案内</span></a>
      </div>

      <div class="pt-2 space-y-3">
        <button
          type="button"
          onclick="openContactModal(); closeMobileMenu();"
          class="w-full text-center py-3 bg-gold-500 text-noir-950 hover:bg-gold-400 text-xs tracking-widest uppercase font-medium transition-colors"
        >
          お問い合わせ
        </button>
        <a
          href={`tel:${store.tel.replace(/-/g, '')}`}
          class="block w-full text-center py-2.5 border border-white/30 text-cream-100 text-xs tracking-widest font-medium hover:border-gold-400 transition-colors"
        >
          お電話: {store.tel}
        </a>
      </div>
    </div>
  </header>
</div>

<script is:inline>
  const headerWrapper = document.getElementById('header-wrapper');
  const announcementBar = document.getElementById('announcement-bar');
  const logoTitle = document.getElementById('logo-title');
  const logoSubtitle = document.getElementById('logo-subtitle');
  const desktopNav = document.getElementById('desktop-nav');
  const contactBtn = document.getElementById('contact-btn');
  const mobileToggle = document.getElementById('mobile-menu-toggle');

  function updateHeaderTransparency() {
    const isScrolled = window.scrollY > 40;

    if (isScrolled) {
      // Solid / Light background after scrolling past Hero top
      headerWrapper.classList.remove('text-cream-50', 'bg-transparent');
      headerWrapper.classList.add('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

      logoTitle.classList.remove('text-cream-50');
      logoTitle.classList.add('text-noir-900');

      logoSubtitle.classList.remove('text-cream-200');
      logoSubtitle.classList.add('text-stone-500');

      desktopNav.classList.remove('text-cream-100');
      desktopNav.classList.add('text-stone-700');

      contactBtn.classList.remove('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
      contactBtn.classList.add('border-stone-800', 'text-noir-900', 'hover:bg-noir-900', 'hover:text-cream-50');

      mobileToggle.classList.remove('text-cream-50');
      mobileToggle.classList.add('text-stone-800');
    } else {
      // Transparent background inside Hero section
      headerWrapper.classList.add('text-cream-50', 'bg-transparent');
      headerWrapper.classList.remove('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

      logoTitle.classList.add('text-cream-50');
      logoTitle.classList.remove('text-noir-900');

      logoSubtitle.classList.add('text-cream-200');
      logoSubtitle.classList.remove('text-stone-500');

      desktopNav.classList.add('text-cream-100');
      desktopNav.classList.remove('text-stone-700');

      contactBtn.classList.add('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
      contactBtn.classList.remove('border-stone-800', 'text-noir-900', 'hover:bg-noir-900', 'hover:text-cream-50');

      mobileToggle.classList.add('text-cream-50');
      mobileToggle.classList.remove('text-stone-800');
    }
  }

  window.addEventListener('scroll', updateHeaderTransparency, { passive: true });
  updateHeaderTransparency();

  // Mobile Drawer Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMobileMenu() {
    const isHidden = mobileMenu.classList.contains('hidden');
    if (isHidden) {
      mobileMenu.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
    } else {
      closeMobileMenu();
    }
  }

  function closeMobileMenu() {
    mobileMenu.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
  }

  toggleBtn?.addEventListener('click', toggleMobileMenu);

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>
