---
import { newsItems } from '../data/news';
import { siteConfig } from '../data/siteConfig';
const { news: newsText } = siteConfig.content;
---

<section id="news" class="py-24 sm:py-32 bg-cream-50 text-noir-900 border-t border-stone-200/60 overflow-hidden">
  <!-- News List Section (Standard Width Container) -->
  <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16 sm:mb-20">
      <span class="text-xs font-sans tracking-mega-wide uppercase text-gold-600 block">{newsText.badge}</span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-ultra-wide font-light uppercase">
        {newsText.titleEn}
      </h2>
      <div class="w-12 h-[1px] bg-gold-400 mx-auto"></div>
    </div>

    <!-- News List -->
    <div class="max-w-5xl mx-auto divide-y divide-stone-200 border-y border-stone-200">
      {newsItems.map(item => (
        <article class="py-6 sm:py-7 group hover:bg-cream-100/50 transition-colors px-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="min-w-[120px] sm:min-w-[140px]">
              <time datetime={item.date} class="text-xs font-sans text-stone-500 tracking-wider">
                {item.date}
              </time>
            </div>
            
            <div class="flex-1 space-y-1.5">
              <h3 class="text-sm sm:text-base font-serif-jp font-medium text-stone-900 group-hover:text-gold-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-stone-600 font-serif-jp leading-relaxed">
                {item.excerpt}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
