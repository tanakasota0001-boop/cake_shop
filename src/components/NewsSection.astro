---
import { newsItems } from '../data/news';
import { siteConfig } from '../data/siteConfig';
const { gallery } = siteConfig.images;
const { news: newsText } = siteConfig.content;
const { store } = siteConfig;

// Seamless loop needs 2 identical sets of images
const loopedGallery = [...gallery, ...gallery];
---

<section id="news" class="pt-24 sm:pt-32 pb-16 sm:pb-24 bg-cream-50 text-noir-900 border-t border-stone-200/60 overflow-hidden">
  <!-- News List Section (Standard Width Container) -->
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in mb-20 sm:mb-28">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-16 sm:mb-20">
      <span class="text-xs font-sans tracking-mega-wide uppercase text-gold-600 block">{newsText.badge}</span>
      <h2 class="text-3xl sm:text-5xl font-serif-title tracking-ultra-wide font-light uppercase">
        {newsText.titleEn}
      </h2>
      <div class="w-12 h-[1px] bg-gold-400 mx-auto"></div>
      <p class="font-serif-jp text-sm text-stone-600 tracking-widest pt-2">{newsText.subtitleJa}</p>
    </div>

    <!-- News List -->
    <div class="max-w-4xl mx-auto divide-y divide-stone-200 border-y border-stone-200">
      {newsItems.map(item => (
        <article class="py-6 sm:py-7 group hover:bg-cream-100/50 transition-colors px-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="flex items-center gap-3 min-w-[170px]">
              <time datetime={item.date} class="text-xs font-sans text-stone-500 tracking-wider">
                {item.date}
              </time>
              <span class="text-[10px] font-sans tracking-widest uppercase px-2 py-0.5 rounded-sm bg-stone-200 text-stone-700">
                {item.category}
              </span>
            </div>
            
            <div class="flex-1 space-y-1.5">
              <h3 class="text-sm sm:text-base font-serif-jp font-medium text-stone-900 group-hover:text-gold-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-stone-600 font-serif-jp leading-relaxed">
                {item.excerpt}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Full-Width Instagram Gallery Showcase -->
  <div class="w-full">
    <!-- Header info in center container -->
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 mb-8 flex flex-col sm:flex-row justify-between items-center border-b border-stone-200 pb-4">
      <div class="text-center sm:text-left">
        <span class="text-[10px] font-sans tracking-mega-wide uppercase text-gold-600 block">Social Media</span>
        <h3 class="text-xl sm:text-2xl font-serif-jp text-stone-900">{newsText.instagramTitle}</h3>
        <p class="text-xs text-stone-500 font-sans tracking-wider mt-0.5">{store.instagramAccountName}</p>
      </div>
      <a
        href={store.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 sm:mt-0 inline-flex items-center gap-2 text-xs font-sans tracking-widest uppercase text-noir-900 hover:text-gold-600 transition-colors group"
      >
        <span>{newsText.instagramCta}</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Continuous Infinite Marquee Track (Full-width, Right to Left) -->
    <div class="relative w-full overflow-hidden marquee-container py-2 select-none">
      <div class="flex marquee-track">
        {loopedGallery.map((photo) => (
          <a
            href={store.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex-shrink-0 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 mx-2 sm:mx-3 overflow-hidden bg-stone-200 rounded-sm shadow-md block"
          >
            <img
              src={photo.url}
              alt={photo.caption}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
            />
            <!-- Subtle Dark Gradient & Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-noir-950/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
              <span class="text-xs text-cream-50 font-serif-jp tracking-wider line-clamp-2 drop-shadow-sm mb-1">
                {photo.caption}
              </span>
              <span class="text-[10px] font-sans tracking-widest text-gold-400 uppercase flex items-center gap-1">
                <span>View on Instagram</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Continuous infinite right-to-left marquee animation */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 38s linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
