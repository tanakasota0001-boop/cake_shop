---
import { siteConfig } from '../data/siteConfig';
const { store } = siteConfig;
const { store: storeText } = siteConfig.content;
---

<section id="store" class="py-20 sm:py-28 bg-cream-100 text-noir-900 relative">
  <div class="max-w-[1240px] mx-auto px-6 sm:px-8 lg:px-12 scroll-fade-in">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-12 sm:mb-16">
      <span class="text-xs font-sans tracking-mega-wide uppercase text-gold-600 block">{storeText.badge}</span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif-title tracking-ultra-wide font-light uppercase">
        {storeText.titleEn}
      </h2>
      <div class="w-12 h-[1px] bg-gold-400 mx-auto"></div>
    </div>

    <!-- Store Layout: Unified Store Info & Calendar on Left, Map on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Column: Unified Boutique Card (Info + Calendar Harmonized) -->
      <div class="lg:col-span-6 flex flex-col justify-between bg-cream-50 border border-stone-200/90 shadow-sm rounded-sm p-6 sm:p-8">
        
        <!-- Top: Store Identity -->
        <div class="border-b border-stone-200 pb-5">
          <div class="flex justify-between items-baseline flex-wrap gap-2">
            <div>
              <span class="text-[10px] font-sans tracking-mega-wide uppercase text-gold-600 block mb-0.5">{store.nameEn}</span>
              <h3 class="text-2xl font-serif-jp text-stone-900 font-medium">{store.nameJa}</h3>
            </div>
          </div>
        </div>

        <!-- Middle: Key Details Grid -->
        <dl class="py-5 divide-y divide-stone-200/60 text-xs sm:text-sm font-serif-jp space-y-0">
          <div class="py-2.5 grid grid-cols-3 gap-2">
            <dt class="text-stone-500 font-sans tracking-wider uppercase text-[11px]">住所</dt>
            <dd class="col-span-2 text-stone-900 font-light">
              〒{store.postalCode} {store.address}
            </dd>
          </div>
          <div class="py-2.5 grid grid-cols-3 gap-2 items-center">
            <dt class="text-stone-500 font-sans tracking-wider uppercase text-[11px]">電話番号</dt>
            <dd class="col-span-2 text-stone-900 font-sans font-medium">
              <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-600 transition-colors inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                {store.tel}
              </a>
            </dd>
          </div>
          <div class="py-2.5 grid grid-cols-3 gap-2">
            <dt class="text-stone-500 font-sans tracking-wider uppercase text-[11px]">営業時間</dt>
            <dd class="col-span-2 text-stone-900 font-light">
              <span>{store.businessHours}</span>
              <span class="text-[11px] text-stone-500 ml-1.5">（{store.holidays}定休）</span>
            </dd>
          </div>
          <div class="py-2.5 grid grid-cols-3 gap-2">
            <dt class="text-stone-500 font-sans tracking-wider uppercase text-[11px]">アクセス</dt>
            <dd class="col-span-2 text-stone-900 font-light text-xs space-y-0.5">
              {store.accessList.map(item => (
                <p class="truncate">• {item}</p>
              ))}
            </dd>
          </div>
          {store.parking && (
            <div class="py-2.5 grid grid-cols-3 gap-2">
              <dt class="text-stone-500 font-sans tracking-wider uppercase text-[11px]">駐車場</dt>
              <dd class="col-span-2 text-stone-900 font-light text-xs">
                {store.parking}
              </dd>
            </div>
          )}
        </dl>

        <!-- Integrated Calendar Sub-section -->
        <div class="pt-4 border-t border-stone-200">
          <div class="flex justify-between items-center mb-3">
            <div>
              <h4 class="text-xs font-sans tracking-widest uppercase text-stone-800 font-medium">{storeText.calendarTitle}</h4>
            </div>
            <div class="flex items-center space-x-1.5">
              <button
                type="button"
                id="cal-prev-btn"
                class="p-1 rounded border border-stone-300 hover:bg-stone-100 text-stone-600 transition-colors"
                aria-label="前月"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <span id="cal-month-title" class="text-xs font-sans font-medium text-stone-800 px-2 min-w-[75px] text-center"></span>
              <button
                type="button"
                id="cal-next-btn"
                class="p-1 rounded border border-stone-300 hover:bg-stone-100 text-stone-600 transition-colors"
                aria-label="次月"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- Calendar Days Grid -->
          <div class="calendar-wrapper bg-stone-50/60 p-2.5 rounded border border-stone-200/70">
            <div class="grid grid-cols-7 gap-1 text-center font-sans text-[11px] text-stone-400 mb-1 font-medium">
              <span class="text-berry-700">日</span>
              <span>月</span>
              <span>火</span>
              <span>水</span>
              <span>木</span>
              <span>金</span>
              <span class="text-blue-600">土</span>
            </div>
            <div id="calendar-days-container" class="grid grid-cols-7 gap-1 text-center font-sans text-xs"></div>
          </div>

          <!-- Calendar Legend -->
          <div class="mt-3 flex flex-wrap items-center justify-between text-[11px] text-stone-500 gap-2 font-serif-jp pt-1">
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-berry-700/20 border border-berry-700/50"></span>
                <span>{storeText.legendHoliday}</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-gold-400/30 border border-gold-500"></span>
                <span>{storeText.legendToday}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Map Frame (Full Height on Desktop) -->
      <div class="lg:col-span-6 h-full min-h-[420px] sm:min-h-[500px] lg:min-h-full">
        <div class="w-full h-full min-h-[420px] sm:min-h-[500px] lg:min-h-full bg-stone-200 border border-stone-300 overflow-hidden shadow-sm rounded-sm">
          <iframe
            src={store.googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 100%; height: 100%;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="店舗所在地マップ"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Inject weekly holiday days for script -->
<script define:vars={{ weeklyHolidayDays: store.weeklyHolidayDays }}>
  window.__WEEKLY_HOLIDAYS__ = weeklyHolidayDays || [2, 3];
</script>

<script is:inline>
  let currentCalDate = new Date();
  let viewYear = currentCalDate.getFullYear();
  let viewMonth = currentCalDate.getMonth();

  function isStoreHoliday(year, month, day) {
    const d = new Date(year, month, day);
    const dayOfWeek = d.getDay(); // 0: Sun, 1: Mon, 2: Tue...
    const holidays = window.__WEEKLY_HOLIDAYS__ || [2, 3];
    return holidays.includes(dayOfWeek);
  }

  function renderCalendar(year, month) {
    const container = document.getElementById('calendar-days-container');
    const title = document.getElementById('cal-month-title');
    if (!container || !title) return;

    title.textContent = `${year}年 ${month + 1}月`;
    container.innerHTML = '';

    const firstDayIndex = new Date(year, month, 1).getDay();
    const lastDayDate = new Date(year, month + 1, 0).getDate();

    for (let i = 0; i < firstDayIndex; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'h-9 text-stone-300 flex items-center justify-center';
      container.appendChild(emptyCell);
    }

    const today = new Date();
    const isThisMonth = today.getFullYear() === year && today.getMonth() === month;

    for (let day = 1; day <= lastDayDate; day++) {
      const dayCell = document.createElement('div');
      const isHoliday = isStoreHoliday(year, month, day);
      const isCurrentDay = isThisMonth && today.getDate() === day;
      const dayOfWeek = new Date(year, month, day).getDay();

      let cellClass = 'h-9 flex flex-col items-center justify-center rounded-sm transition-colors text-xs ';

      if (isCurrentDay) {
        cellClass += 'ring-1 ring-gold-500 font-bold bg-gold-400/10 ';
      }

      if (isHoliday) {
        cellClass += 'bg-berry-700/10 text-berry-800 font-medium ';
      } else {
        if (dayOfWeek === 0) cellClass += 'text-berry-700 ';
        else if (dayOfWeek === 6) cellClass += 'text-blue-600 ';
        else cellClass += 'text-stone-800 hover:bg-stone-100 ';
      }

      dayCell.className = cellClass;
      dayCell.innerHTML = `
        <span>${day}</span>
        ${isHoliday ? '<span class="text-[8px] scale-90 leading-none text-berry-700/80">休</span>' : ''}
      `;

      container.appendChild(dayCell);
    }
  }

  document.getElementById('cal-prev-btn')?.addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) {
      viewMonth = 11;
      viewYear--;
    }
    renderCalendar(viewYear, viewMonth);
  });

  document.getElementById('cal-next-btn')?.addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) {
      viewMonth = 0;
      viewYear++;
    }
    renderCalendar(viewYear, viewMonth);
  });

  renderCalendar(viewYear, viewMonth);
</script>
